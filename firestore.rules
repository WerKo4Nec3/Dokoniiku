rules_version = '2';

// Deploy from Firebase Console → Firestore Database → Rules, or with
// `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Admins are listed by uid in /admins (create the doc by hand in the
    // Firebase Console — no client can write there).
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isDay(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---- Private per-user data: journeys, recent history, tabibito profile.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Public tabibito profiles (name, avatar, friend code, stats).
    // Readable by any signed-in user so friends can find each other;
    // only the owner can write.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Friend requests. Document id is "<fromUid>_<toUid>".
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid != request.resource.data.toUid
        && requestId
          == request.resource.data.fromUid + "_" + request.resource.data.toUid;
      // Either side can withdraw / decline (accepting also deletes it).
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    // ---- Friendships. Document id is "<uidA>_<uidB>" with the two uids
    // sorted; `members` holds both uids, `requestFrom` is the inviter.
    // Created by the invited user while the invite still exists.
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.requestFrom in request.resource.data.members
        && request.resource.data.requestFrom != request.auth.uid
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestFrom + "_" + request.auth.uid));
      // Either member can unfriend.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---- Groups: a named circle of travellers with a chat and events.
    match /groups/{groupId} {
      function groupMembers() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      // Members read any group they belong to; anyone signed-in may read a
      // group explicitly marked public (so discover/search + the preview page
      // work). Private groups without the flag stay member-only.
      allow read: if signedIn() && (
        request.auth.uid in resource.data.members
        || resource.data.visibility == "public"
        || isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      // (a) an existing member edits (rename / invite / leave); owner fixed.
      // (b) a non-member SELF-JOINS a public group: the ONLY change allowed is
      //     appending their own uid to `members` — nothing else may move.
      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          resource.data.visibility == "public"
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        )
      );
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      // Group chat.
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in groupMembers();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in groupMembers();
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Joint-trip events built from a saved journey card.
      match /events/{eventId} {
        allow read: if signedIn() && request.auth.uid in groupMembers();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in groupMembers();
        // Members join/leave by updating the participants array.
        allow update: if signedIn() && request.auth.uid in groupMembers();
        allow delete: if signedIn()
          && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      }

      // "Where should we go?" polls. Members read + vote (update); creator or
      // group owner can delete.
      match /polls/{pollId} {
        allow read: if signedIn() && request.auth.uid in groupMembers();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in groupMembers();
        allow update: if signedIn() && request.auth.uid in groupMembers();
        allow delete: if signedIn()
          && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      }
    }

    // ---- Place ratings (👍/👎). Counters are public (the randomizer drops
    // heavily-disliked places for everyone), votes are private per user. The
    // counters may only move in exact lock-step with the caller's own vote doc
    // changing in the same transaction — no ballot stuffing.
    match /placeRatings/{placeId} {
      function votePath() {
        return /databases/$(database)/documents/placeRatings/$(placeId)/votes/$(request.auth.uid);
      }
      function hadVote() { return exists(votePath()); }
      function before() { return get(votePath()).data.value; }
      function after() { return getAfter(votePath()).data.value; }
      function freshVoteAfterWrite() {
        return existsAfter(votePath())
          && getAfter(votePath()).data.updatedAt == request.time;
      }

      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["up", "down", "name", "prefecture", "updatedAt"])
        && request.resource.data.updatedAt == request.time
        && !hadVote()
        && freshVoteAfterWrite()
        && ((after() == 1 && request.resource.data.up == 1 && request.resource.data.down == 0)
          || (after() == -1 && request.resource.data.up == 0 && request.resource.data.down == 1));

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["up", "down", "updatedAt"])
        && request.resource.data.updatedAt == request.time
        && freshVoteAfterWrite()
        && (
          (!hadVote() && after() == 1
            && request.resource.data.up == resource.data.up + 1
            && request.resource.data.down == resource.data.down)
          || (!hadVote() && after() == -1
            && request.resource.data.up == resource.data.up
            && request.resource.data.down == resource.data.down + 1)
          || (hadVote() && before() == 1 && after() == -1
            && request.resource.data.up == resource.data.up - 1
            && request.resource.data.down == resource.data.down + 1)
          || (hadVote() && before() == -1 && after() == 1
            && request.resource.data.up == resource.data.up + 1
            && request.resource.data.down == resource.data.down - 1)
        );

      // Admin override: put a disliked place back into the randomizer.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["whitelisted"])
        && request.resource.data.whitelisted is bool;

      match /votes/{uid} {
        // A vote may only change together with the counters (same transaction).
        function counterWrittenNow() {
          return existsAfter(/databases/$(database)/documents/placeRatings/$(placeId))
            && getAfter(/databases/$(database)/documents/placeRatings/$(placeId)).data.updatedAt == request.time;
        }
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["value", "updatedAt"])
          && (request.resource.data.value == 1 || request.resource.data.value == -1)
          && request.resource.data.updatedAt == request.time
          && counterWrittenNow();
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["value", "updatedAt"])
          && (request.resource.data.value == 1 || request.resource.data.value == -1)
          && request.resource.data.value != resource.data.value
          && request.resource.data.updatedAt == request.time
          && counterWrittenNow();
      }
    }

    // ---- Admin + first-party analytics (counters only, +1 steps) ----
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // One doc per user: first/last day seen (user totals + daily actives).
    match /userIndex/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["firstSeen", "lastSeen"])
        && isDay(request.resource.data.firstSeen)
        && isDay(request.resource.data.lastSeen);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lastSeen"])
        && isDay(request.resource.data.lastSeen);
    }

    // Daily counters. Anyone (even signed-out visitors) may add exactly +1.
    match /stats_daily/{day} {
      function now(f) { return request.resource.data.get(f, 0); }
      function was(f) { return resource.data.get(f, 0); }
      function step(f) { return now(f) == was(f) || now(f) == was(f) + 1; }
      function fresh(f) { return now(f) == 0 || now(f) == 1; }

      allow read: if isAdmin();
      allow create: if isDay(day)
        && request.resource.data.keys().hasOnly(["date", "visitors", "sessions", "searches", "saves", "signups"])
        && request.resource.data.date == day
        && fresh("visitors") && fresh("sessions") && fresh("searches")
        && fresh("saves") && fresh("signups");
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["visitors", "sessions", "searches", "saves", "signups"])
        && step("visitors") && step("sessions") && step("searches")
        && step("saves") && step("signups");
    }

    // All-time searches per prefecture / per genre.
    match /stats_prefs/{id} {
      allow read: if isAdmin();
      allow create: if id in ["hokkaido", "aomori", "iwate", "miyagi", "akita", "yamagata", "fukushima", "ibaraki", "tochigi", "gunma", "saitama", "chiba", "tokyo", "kanagawa", "niigata", "yamanashi", "nagano", "toyama", "ishikawa", "fukui", "gifu", "shizuoka", "aichi", "mie", "shiga", "kyoto", "osaka", "hyogo", "nara", "wakayama", "tottori", "shimane", "okayama", "hiroshima", "yamaguchi", "tokushima", "kagawa", "ehime", "kochi", "fukuoka", "saga", "nagasaki", "kumamoto", "oita", "miyazaki", "kagoshima", "okinawa"]
        && request.resource.data.keys().hasOnly(["n"])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["n"])
        && request.resource.data.n == resource.data.n + 1;
    }
    match /stats_cats/{id} {
      allow read: if isAdmin();
      allow create: if id in ["nature", "history", "shrine", "museum", "hot-spring", "food", "viewpoint"]
        && request.resource.data.keys().hasOnly(["n"])
        && request.resource.data.n == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["n"])
        && request.resource.data.n == resource.data.n + 1;
    }

    // ---- Cards shared between friends. `friendshipId` must point at an
    // existing friendship that contains both sides.
    // ---- Travel records: one public review per traveller per place.
    // Written by the owner after arriving; anyone can read them.
    match /placeReviews/{placeId}/reviews/{uid} {
      allow read: if true;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'name', 'avatarEmoji', 'avatarColor',
          'rating', 'text', 'photoIds', 'placeName', 'prefecture', 'verified',
          'visitedAt', 'createdAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.photoIds is list && request.resource.data.photoIds.size() <= 4
        && request.resource.data.verified is bool;
      allow delete: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    // ---- Trip photos: one compressed JPEG (base64) per document, < 1 MiB.
    match /photos/{photoId} {
      allow get: if resource.data.public == true
        || (signedIn() && resource.data.owner == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'placeId', 'data', 'mime', 'w', 'h', 'public', 'createdAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 800000
        && request.resource.data.mime == 'image/jpeg'
        && request.resource.data.public is bool;
      allow delete: if signedIn() && (resource.data.owner == request.auth.uid || isAdmin());
    }

    // ---- Live location: the sharer's latest position, visible only to the
    // friends they picked, for at most ~8 hours.
    match /liveLocations/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || request.auth.uid in resource.data.viewers);
      allow list: if signedIn() && request.auth.uid in resource.data.viewers;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.viewers is list
        && request.resource.data.viewers.size() <= 50
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(9, 'h');
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /sharedCards/{cardId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && exists(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId))
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.members.hasAll([
          request.resource.data.fromUid,
          request.resource.data.toUid
        ]);
      // The recipient can clear their inbox; the sender can retract.
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }
  }
}
