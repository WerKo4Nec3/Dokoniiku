rules_version = '2';

// Deploy from Firebase Console → Firestore Database → Rules, or with
// `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // ---- Private per-user data: journeys, recent history, tabibito profile.
    match /users/{uid}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---- Public tabibito profiles (name, avatar, friend code, stats).
    // Readable by any signed-in user so friends can find each other;
    // only the owner can write.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- Friend requests. Document id is "<fromUid>_<toUid>".
    match /friendRequests/{requestId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromUid != request.resource.data.toUid
        && requestId
          == request.resource.data.fromUid + "_" + request.resource.data.toUid;
      // Either side can withdraw / decline (accepting also deletes it).
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }

    // ---- Friendships. Document id is "<uidA>_<uidB>" with the two uids
    // sorted; `members` holds both uids, `requestFrom` is the inviter.
    // Created by the invited user while the invite still exists.
    match /friendships/{friendshipId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && request.resource.data.requestFrom in request.resource.data.members
        && request.resource.data.requestFrom != request.auth.uid
        && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.requestFrom + "_" + request.auth.uid));
      // Either member can unfriend.
      allow delete: if signedIn() && request.auth.uid in resource.data.members;
    }

    // ---- Groups: a named circle of travellers with a chat and events.
    match /groups/{groupId} {
      function groupMembers() {
        return get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }

      // Members read any group they belong to; anyone signed-in may read a
      // group explicitly marked public (so discover/search + the preview page
      // work). Private groups without the flag stay member-only.
      allow read: if signedIn() && (
        request.auth.uid in resource.data.members
        || resource.data.visibility == "public"
      );
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.auth.uid in request.resource.data.members;
      // (a) an existing member edits (rename / invite / leave); owner fixed.
      // (b) a non-member SELF-JOINS a public group: the ONLY change allowed is
      //     appending their own uid to `members` — nothing else may move.
      allow update: if signedIn() && (
        (
          request.auth.uid in resource.data.members
          && request.resource.data.ownerUid == resource.data.ownerUid
        )
        || (
          resource.data.visibility == "public"
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["members"])
          && request.resource.data.members == resource.data.members.concat([request.auth.uid])
        )
      );
      allow delete: if signedIn()
        && resource.data.ownerUid == request.auth.uid;

      // Group chat.
      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in groupMembers();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && request.auth.uid in groupMembers();
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // Joint-trip events built from a saved journey card.
      match /events/{eventId} {
        allow read: if signedIn() && request.auth.uid in groupMembers();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in groupMembers();
        // Members join/leave by updating the participants array.
        allow update: if signedIn() && request.auth.uid in groupMembers();
        allow delete: if signedIn()
          && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      }

      // "Where should we go?" polls. Members read + vote (update); creator or
      // group owner can delete.
      match /polls/{pollId} {
        allow read: if signedIn() && request.auth.uid in groupMembers();
        allow create: if signedIn()
          && request.resource.data.createdBy == request.auth.uid
          && request.auth.uid in groupMembers();
        allow update: if signedIn() && request.auth.uid in groupMembers();
        allow delete: if signedIn()
          && (resource.data.createdBy == request.auth.uid
            || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);
      }
    }

    // ---- Place ratings (👍/👎). Counters are public (the randomizer drops
    // heavily-disliked places for everyone), votes are private per user. The
    // counters may only move in exact lock-step with the caller's own vote doc
    // changing in the same transaction — no ballot stuffing.
    match /placeRatings/{placeId} {
      function votePath() {
        return /databases/$(database)/documents/placeRatings/$(placeId)/votes/$(request.auth.uid);
      }
      function hadVote() { return exists(votePath()); }
      function before() { return get(votePath()).data.value; }
      function after() { return getAfter(votePath()).data.value; }
      function freshVoteAfterWrite() {
        return existsAfter(votePath())
          && getAfter(votePath()).data.updatedAt == request.time;
      }

      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(["up", "down", "name", "prefecture", "updatedAt"])
        && request.resource.data.updatedAt == request.time
        && !hadVote()
        && freshVoteAfterWrite()
        && ((after() == 1 && request.resource.data.up == 1 && request.resource.data.down == 0)
          || (after() == -1 && request.resource.data.up == 0 && request.resource.data.down == 1));

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["up", "down", "updatedAt"])
        && request.resource.data.updatedAt == request.time
        && freshVoteAfterWrite()
        && (
          (!hadVote() && after() == 1
            && request.resource.data.up == resource.data.up + 1
            && request.resource.data.down == resource.data.down)
          || (!hadVote() && after() == -1
            && request.resource.data.up == resource.data.up
            && request.resource.data.down == resource.data.down + 1)
          || (hadVote() && before() == 1 && after() == -1
            && request.resource.data.up == resource.data.up - 1
            && request.resource.data.down == resource.data.down + 1)
          || (hadVote() && before() == -1 && after() == 1
            && request.resource.data.up == resource.data.up + 1
            && request.resource.data.down == resource.data.down - 1)
        );

      match /votes/{uid} {
        // A vote may only change together with the counters (same transaction).
        function counterWrittenNow() {
          return existsAfter(/databases/$(database)/documents/placeRatings/$(placeId))
            && getAfter(/databases/$(database)/documents/placeRatings/$(placeId)).data.updatedAt == request.time;
        }
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["value", "updatedAt"])
          && (request.resource.data.value == 1 || request.resource.data.value == -1)
          && request.resource.data.updatedAt == request.time
          && counterWrittenNow();
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(["value", "updatedAt"])
          && (request.resource.data.value == 1 || request.resource.data.value == -1)
          && request.resource.data.value != resource.data.value
          && request.resource.data.updatedAt == request.time
          && counterWrittenNow();
      }
    }

    // ---- Cards shared between friends. `friendshipId` must point at an
    // existing friendship that contains both sides.
    match /sharedCards/{cardId} {
      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && exists(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId))
        && get(/databases/$(database)/documents/friendships/$(request.resource.data.friendshipId)).data.members.hasAll([
          request.resource.data.fromUid,
          request.resource.data.toUid
        ]);
      // The recipient can clear their inbox; the sender can retract.
      allow delete: if signedIn()
        && (resource.data.fromUid == request.auth.uid
          || resource.data.toUid == request.auth.uid);
    }
  }
}
